##############################################################################
# TEC EQUATIONS
##############################################################################

Cold Side Heat

Qc = αITc
     - (1/2)I²R
     - K(Th - Tc)


TEC Voltage

V = α(Th - Tc)
    + IR


Electrical Power

Pe = VI


Hot Side Heat

Qh = Qc + VI


##############################################################################
# HSN POLAR EQUATION
##############################################################################

P = Polar Command

Range

-1 <= P <= +1


Current Direction

I = P × Imax


Examples

P = -1.0

Maximum Heat


P = -0.50

Medium Heat


P = 0

Neutral


P = +0.50

Medium Cool


P = +1.0

Maximum Cool


##############################################################################
# HSN DELTA-T EQUATION
##############################################################################

D = Delta-T Command

Range

0 <= D <= 1


Current Magnitude

Imag = D × Imax


Examples

D = 0

No Temperature Difference


D = 0.50

Half Difference


D = 1.00

Maximum Difference


##############################################################################
# COMBINED POLAR + DELTA-T EQUATION
##############################################################################

Actual Current

Iactual = P × D × Imax


Examples

P = +1
D = 1

Maximum Cooling


P = +1
D = 0.25

Small Cooling


P = -1
D = 1

Maximum Heating


P = -1
D = 0.25

Small Heating


##############################################################################
# POLAR TEMPERATURE MODEL
##############################################################################

Reference Values

Ambient    = 27 C

Cold Limit = -35 C

Hot Limit  = +75 C


Cold Target

Tc_target

= Ta - P×D×(Ta - Tcold)


Hot Target

Th_target

= Ta + P×D×(Thot - Ta)


